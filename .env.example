# Copy this file to `.env.local` and fill in real values.
# Never commit real values; anything here is a placeholder.
# Never prefix these with NEXT_PUBLIC_ — they are server-side only.

# OpenRouter API key. Read only in server-side code (the /api/chat Route
# Handler); the browser never receives it. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model slug. Free-model availability changes frequently, so verify
# the current catalog at https://openrouter.ai/models before choosing one.
# `openrouter/free` auto-selects an available free model; a specific example is
# `google/gemma-4-31b-it:free`.
OPENROUTER_MODEL=